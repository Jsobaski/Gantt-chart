{
    "dataRoles": [
        {
            "displayName": "Location",
            "name": "location",
            "kind": "Grouping",
            "description": "Location hierarchy (city or region)"
        },
        {
            "displayName": "Project Name",
            "name": "projectName",
            "kind": "Grouping",
            "description": "Project name or ID"
        },
        {
            "displayName": "Milestone Dates",
            "name": "milestoneDate",
            "kind": "GroupingOrMeasure",
            "description": "Drag in as many single-date milestone fields as you need — each becomes its own diamond marker and legend entry. Rename a field (right-click > Rename for this visual) to control its label."
        },
        {
            "displayName": "Bar Start Dates",
            "name": "barStart",
            "kind": "GroupingOrMeasure",
            "description": "Start date for each schedule bar. Add these in the same order as the matching Bar Finish Dates — the 1st Start pairs with the 1st Finish, and so on."
        },
        {
            "displayName": "Bar Finish Dates",
            "name": "barFinish",
            "kind": "GroupingOrMeasure",
            "description": "Finish date for each schedule bar. Add these in the same order as the matching Bar Start Dates — the 1st Finish pairs with the 1st Start, and so on."
        },
        {
            "displayName": "Additional Tooltip Fields",
            "name": "tooltipFields",
            "kind": "GroupingOrMeasure",
            "description": "Drag any extra columns here to show them in every bar and milestone tooltip"
        }
    ],
    "dataViewMappings": [
        {
            "table": {
                "rows": {
                    "select": [
                        { "for": { "in": "location" } },
                        { "for": { "in": "projectName" } },
                        { "for": { "in": "milestoneDate" } },
                        { "for": { "in": "barStart" } },
                        { "for": { "in": "barFinish" } },
                        { "for": { "in": "tooltipFields" } }
                    ],
                    "dataReductionAlgorithm": {
                        "top": { "count": 2000 }
                    }
                }
            }
        }
    ],
    "objects": {
        "ganttConfig": {
            "properties": {
                "bgColor":   { "type": { "fill": { "solid": { "color": true } } } },
                "textColor": { "type": { "fill": { "solid": { "color": true } } } }
            }
        },
        "dataColors": {
            "properties": {
                "fill": { "type": { "fill": { "solid": { "color": true } } } }
            }
        }
    },
    "privileges": []
}
